{
  "name": "@facet/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test scripts package.json tsconfig.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build",
    "smoke:local": "npm run build && tsx scripts/local-smoke.ts",
    "smoke:live": "npm run build && tsx scripts/live-local-smoke.ts",
    "smoke:launcher": "npm run build && tsx scripts/launcher-smoke.ts"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "viem": "2.57.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
